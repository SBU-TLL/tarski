###############################################################################
# tarski — production environment template
#
# Copy to your runtime secret store / Azure container env (do NOT commit a real
# .env). Values here are PLACEHOLDERS. tarski is a fully static A-Frame/WebXR
# experience: it needs NO database, NO authentication, and NO application
# secrets. This template mainly documents the platform/runtime contract.
#
# Nothing here is baked into the image; the container reads these at runtime.
###############################################################################

# --- Environment flag --------------------------------------------------------
APP_ENV=production
TZ=America/New_York

# --- Ingress / routing -------------------------------------------------------
PUBLIC_HOSTNAME=tarski.<your-subdomain>.stonybrook.edu
# Apache listens on 8080 inside the container (non-root); the ingress forwards
# 443 -> 8080. "/" serves index.html.
#
# WebXR REQUIRES a secure context (HTTPS): the ingress MUST terminate TLS so the
# page is served over https:// to the browser, or "Enter VR" will be unavailable.
APACHE_LISTEN_PORT=8080

# --- Authentication ----------------------------------------------------------
# NONE. Public static experience. If access must be restricted, enforce it at
# the ingress / reverse proxy (Ansible-managed), not in this container.

# --- Database ----------------------------------------------------------------
# NONE.

# --- Application secrets -----------------------------------------------------
# NONE.

# --- External dependencies (informational) -----------------------------------
# The app loads A-Frame + components and jQuery from PUBLIC CDNs (aframe.io,
# cdn.jsdelivr.net, cdnjs.cloudflare.com, unpkg.com, code.jquery.com) — NOT
# internal SBU projects. If the deployment must work offline / behind strict
# egress, vendor these locally (note: some CDN <script> tags lack Subresource
# Integrity). No internal-project dependencies.
